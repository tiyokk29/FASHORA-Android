<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="20dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FASHORA"
                android:textColor="@color/primary"
                android:textSize="23sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="SELLER CENTER"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.12"/>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSellerLogout"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_category"
            android:src="@android:drawable/ic_lock_power_off"
            android:contentDescription="Logout"
            android:padding="11dp"
            app:tint="@color/primary"/>

    </LinearLayout>

    <!-- WELCOME -->
    <TextView
        android:id="@+id/tvSellerGreeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Halo, Seller!"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Kelola produk fashion tokomu di sini."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"/>

    <!-- STATISTICS CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="125dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_promo_banner"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOTAL PRODUK SAYA"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <TextView
            android:id="@+id/tvTotalProducts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- PRODUCT SECTION HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Produk Saya"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvSellerProductCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 produk"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- ADD PRODUCT BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddProduct"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="+ Tambah Produk Baru"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:backgroundTint="@color/primary"
        app:cornerRadius="14dp"
        app:elevation="0dp"/>

    <!-- LOADING / EMPTY MESSAGE -->
    <TextView
        android:id="@+id/tvSellerMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:padding="20dp"
        android:text="Memuat produk..."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone"/>

    <!-- PRODUCT LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSellerProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:overScrollMode="never"/>

</LinearLayout>
