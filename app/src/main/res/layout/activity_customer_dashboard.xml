<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FASHORA"
                    android:textColor="@color/primary"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Halo, Fashion Lover!"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"/>

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNotification"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_category"
                android:src="@android:drawable/ic_dialog_info"
                android:contentDescription="Notifikasi"
                android:padding="11dp"
                app:tint="@color/primary"/>

            <ImageButton
                android:id="@+id/btnCustomerLogout"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="9dp"
                android:background="@drawable/bg_category"
                android:src="@android:drawable/ic_lock_power_off"
                android:contentDescription="Logout"
                android:padding="11dp"
                app:tint="@color/error"/>

        </LinearLayout>

        <!-- SEARCH -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="8dp"
            android:hint="Cari produk fashion..."
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:boxStrokeColor="@color/secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="14sp"
                android:inputType="text"
                android:imeOptions="actionSearch"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- PROMO BANNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="155dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_promo_banner"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPLORE YOUR STYLE"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Tampil percaya diri dengan fashion lokal pilihan."
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold"
                android:maxLines="2"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Discover Your Style"
                android:textColor="@color/secondary"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- CATEGORY HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginTop="26dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kategori"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAllCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lihat semua"
                android:textColor="@color/primary"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- CATEGORY LIST -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:id="@+id/categoryContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/catAll"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:background="@drawable/bg_category_selected"
                    android:text="Semua"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/catMen"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="9dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:background="@drawable/bg_category"
                    android:text="Pria"
                    android:textColor="@color/primary"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/catWomen"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="9dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:background="@drawable/bg_category"
                    android:text="Wanita"
                    android:textColor="@color/primary"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/catShoes"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="9dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:background="@drawable/bg_category"
                    android:text="Sepatu"
                    android:textColor="@color/primary"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/catBags"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="9dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:background="@drawable/bg_category"
                    android:text="Tas"
                    android:textColor="@color/primary"
                    android:textSize="12sp"/>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- PRODUCT HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Produk Pilihan"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvSeeAllProducts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terbaru"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- RECYCLERVIEW PRODUCT -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp"
            android:overScrollMode="never"/>

    </LinearLayout>

</ScrollView>
